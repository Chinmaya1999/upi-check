{
  "name": "@upi/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:node:sqlite --loader:.html=text",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/api.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "nodemailer": "^10.3.1"
  }
}
