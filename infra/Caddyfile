# HTTPS front end. Caddy obtains and renews Let's Encrypt certificates automatically.
{
	email chinmaya.dob1999@gmail.com
}

# Shared hardening: HSTS (HTTPS only, 1 year), no sniffing/framing, no server banner, capped request bodies.
(secure) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	request_body {
		max_size 6MB
	}
}

# Mobile app API. The admin dashboard is never reachable on this hostname.
api.paisaduniya.in {
	import secure
	encode gzip
	@admin path /admin /admin/*
	respond @admin 404
	reverse_proxy api:3000
}

# Admin dashboard only: /admin and /admin/api/*. Everything else goes to the dashboard.
paisaduniya.in {
	import secure
	encode gzip
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy api:3000
	}
	handle {
		redir https://paisaduniya.in/admin 302
	}
}

www.paisaduniya.in {
	redir https://paisaduniya.in{uri} permanent
}

# Backward compatibility: app builds released before the domain existed call http://13.201.66.53.
# Plain HTTP stays API-only (no admin) and can be removed once those builds are gone.
http://13.201.66.53 {
	@admin path /admin /admin/*
	respond @admin 404
	reverse_proxy api:3000
}
